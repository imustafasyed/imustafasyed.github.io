<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>D3 Circle Interaction</title>
    <style>
        body {
            font-family: sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: 40px;
        }
        #canvas-container {
            border: 2px solid #333;
            background-color: #f4f4f9;
            cursor: crosshair;
            box-shadow: 0px 4px 8px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>
    <h2>Click the canvas to add circles (Max 10)</h2>
    <div id="canvas-container"></div>

    <script type="module">
        import * as d3 from "https://cdn.jsdelivr.net/npm/d3@7/+esm";

        const width = 800;
        const height = 600;
        let svg;

        async function prepareVis() {
            // Set attributes for D3 container canvas
            svg = d3.select("#canvas-container")
                .append("svg")
                .attr("width", width)
                .attr("height", height)
                // Attach the click listener to the entire SVG canvas
                .on("click", handleSvgClick); 
        }

        function handleSvgClick(event) {
            // Get exact coordinates relative to the SVG container
            const [x, y] = d3.pointer(event);

            // Check current number of circles on the canvas
            const circles = svg.selectAll("circle");
            
            // Enforce the maximum of 10 circles rule by removing the oldest
            if (circles.size() >= 10) {
                // Select the first circle in the DOM, shrink it, and remove it
                svg.select("circle")
                   .transition()
                   .duration(200)
                   .attr("r", 0)
                   .remove();
            }

            // Append a new circle at the exact click coordinates
            svg.append("circle")
                .attr("cx", x)
                .attr("cy", y)
                .attr("r", 0) // Start at radius 0 for a pop-in animation
                .attr("fill", d3.interpolateRainbow(Math.random())) // Random color
                .attr("opacity", 0.8)
                .transition() // Add a smooth animation
                .duration(500)
                .ease(d3.easeElasticOut)
                .attr("r", 25); // Grow to target radius
        }

        async function runApp() {
            await prepareVis();
        }

        runApp();
    </script>
</body>
</html>
